{
  "expo": {
    "name": "もしドパ",
    "slug": "moshidopa",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "moshidopa",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-sqlite",
      ["./modules/moshidopa-intents/app.plugin.js", {"deploymentTarget": "16.0"}]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moshidopa.app",
      "infoPlist": {
        "CFBundleDisplayName": "もしドパ"
      }
    },
    "android": {
      "package": "com.moshidopa.app"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
