{
  "expo": {
    "name": "もしドパ",
    "slug": "moshidopa",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "moshidopa",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-sqlite",
      [
        "./modules/moshidopa-intents/app.plugin.js",
        {
          "deploymentTarget": "16.4"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moshidopa.app",
      "infoPlist": {
        "CFBundleDisplayName": "もしドパ"
      }
    },
    "android": {
      "package": "com.moshidopa.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa7b885d-baa1-4704-b52b-81ab35736895"
      }
    },
    "owner": "yurashu"
  }
}
